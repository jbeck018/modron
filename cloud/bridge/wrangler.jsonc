{
  // modron remote-control bridge: a transport-only relay. `modron serve`
  // connects as the agent side of a session; any browser/phone opens
  // /s/<key> to watch and drive it. One command deploys it:
  //   npx wrangler deploy
  // (from this directory, after `npx wrangler login`).
  // Secret, not in this file: PUBLISH_TOKEN (required for /pages publish).
  //   npx wrangler secret put PUBLISH_TOKEN
  "name": "modron-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE",
        "class_name": "SessionBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionBridge"]
    }
  ]
}
